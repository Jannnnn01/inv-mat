{
  "name": "inv-mat-assets",
  "private": true,
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "build:css": "sass --quiet-deps --silence-deprecation=import --load-path=node_modules --no-source-map --style=compressed resources/scss/app.scss public/assets/build/app.css",
    "build:js": "esbuild resources/js/app.js --bundle --minify --outfile=public/assets/build/app.js"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.8"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "sass": "1.94.2"
  }
}
