# Dependencias
/vendor/
/node_modules/
/composer.phar
/composer-setup.php
/composer-setup.sig

# Configuracion local y secretos
/.env
/.env.*
!/.env.example

# Artefactos generados
/public/assets/build/
/build/
/coverage/
/.phpunit.cache/
npm-debug.log*

# CodeIgniter writable (conservar archivos de proteccion)
/writable/cache/*
!/writable/cache/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html
/writable/postgres-local/

# Sistema operativo y editores
.DS_Store
Thumbs.db
Desktop.ini
/.idea/
/.vscode/
/.tools/
