# Entorno local de ejemplo. Copiar como .env y completar sin versionar secretos.
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.defaultLocale = 'es'
app.appTimezone = 'America/Bogota'
app.forceGlobalSecureRequests = false
app.CSPEnabled = true

database.default.hostname = '127.0.0.1'
database.default.database = 'inv_mat'
database.default.username = 'inv_mat_app'
database.default.password = ''
database.default.DBDriver = 'Postgre'
database.default.DBPrefix = ''
database.default.port = 5432
database.default.schema = 'public'
database.default.DBDebug = true

database.tests.hostname = '127.0.0.1'
database.tests.database = 'inv_mat_test'
database.tests.username = 'inv_mat_test'
database.tests.password = ''
database.tests.DBDriver = 'Postgre'
database.tests.DBPrefix = ''
database.tests.port = 5432
database.tests.schema = 'public'

# Generar una clave distinta para cada entorno antes de habilitar cifrado.
encryption.key = ''

# SMTP local de ejemplo para Mailpit. En produccion use el proveedor institucional.
email.fromEmail = 'no-reply@example.invalid'
email.fromName = 'Inventario de materiales'
email.protocol = 'smtp'
email.SMTPHost = '127.0.0.1'
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 1025
email.SMTPCrypto = ''
email.SMTPTimeout = 5

# Gmail en produccion: smtp.gmail.com, puerto 587, TLS y una contrasena de
# aplicacion. Nunca use ni publique la contrasena normal de la cuenta Google.

# Archivos privados. Use local en desarrollo y s3 en producción.
storage.driver = 'local'
storage.maxUploadBytes = 10485760
storage.bucket = ''
storage.region = 'us-east-1'
storage.endpoint = ''
storage.accessKey = ''
storage.secretKey = ''
storage.pathStyle = false

# Health check. En producción se habilita para comprobar también PostgreSQL.
health.databaseCheck = false

# Variables convencionales para contenedores/Render. No son necesarias en XAMPP
# cuando se utilizan las variables con puntos anteriores.
# DATABASE_URL = 'postgresql://usuario:clave@host:5432/base?sslmode=require'
# APP_BASE_URL = 'https://inventario.example.org/'
